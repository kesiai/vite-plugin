{
  "name": "@kesi/vite-plugin",
  "version": "1.0.0",
  "description": "A Vite plugin for KESI development - adds data-code attributes and provides component inspection APIs",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./canvas": {
      "import": "./dist/Canvas.js",
      "types": "./dist/Canvas.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly -p tsconfig.json",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "vite",
    "plugin",
    "react",
    "development"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@yuku-codegen/wasm": "^0.9.3",
    "@yuku-parser/wasm": "^0.9.3",
    "express": "^4.18.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "vite": ">=4.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.0.1",
    "typescript": "^7.0.2"
  }
}
